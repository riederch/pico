<?xml version="1.0" encoding="utf-8"?>
<!-- Adaptive icon: every Android this app installs on (minSdk 26) draws it,
     so there is no bitmap fallback to keep in step. The monochrome layer is
     what Android 13 and later use for themed icons. -->
<adaptive-icon xmlns:android="http://schemas.android.com/apk/res/android">
  <background android:drawable="@color/pico_bg_deep" />
  <foreground android:drawable="@drawable/ic_launcher_foreground" />
  <monochrome android:drawable="@drawable/ic_launcher_foreground" />
</adaptive-icon>
