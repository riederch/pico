{
  "name": "@pico/core",
  "version": "0.2.1",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "scripts": {
    "build": "tsc -p tsconfig.json && node -e \"require('node:fs').copyFileSync('src/supplier-runner.mjs', 'dist/supplier-runner.mjs')\"",
    "check": "tsc -p tsconfig.json --noEmit",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@fastify/websocket": "^11.0.0",
    "@pico/identity": "workspace:*",
    "@pico/link-relay-client": "workspace:*",
    "@pico/module-calendar": "workspace:*",
    "@pico/module-depot": "workspace:*",
    "@pico/module-home-assistant": "workspace:*",
    "@pico/module-spatial-recall": "workspace:*",
    "@pico/protocol": "workspace:*",
    "@pico/sync": "workspace:*",
    "better-sqlite3": "^11.0.0",
    "fastify": "^5.12.3",
    "libsodium-wrappers-sumo": "^0.8.4"
  },
  "devDependencies": {
    "@pico/relay": "workspace:*",
    "@types/better-sqlite3": "^7.6.0"
  }
}
