{
  "name": "@pico/companion",
  "version": "0.1.9",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./alarm-carrier": {
      "types": "./dist/alarm-carrier.d.ts",
      "import": "./dist/alarm-carrier.js"
    },
    "./host-repin": {
      "types": "./dist/host-repin.d.ts",
      "import": "./dist/host-repin.js"
    },
    "./lifecycle-reader": {
      "types": "./dist/lifecycle-reader.d.ts",
      "import": "./dist/lifecycle-reader.js"
    },
    "./notify": {
      "types": "./dist/notify.d.ts",
      "import": "./dist/notify.js"
    },
    "./profile": {
      "types": "./dist/profile.d.ts",
      "import": "./dist/profile.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@pico/protocol": "workspace:*",
    "@pico/vault": "workspace:*",
    "@pico/vault-daemon": "workspace:*"
  },
  "devDependencies": {
    "libsodium-wrappers-sumo": "^0.8.4"
  }
}
