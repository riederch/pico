{
  "name": "@pico/vault-daemon",
  "version": "0.2.0",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist"
  ],
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./claim-home-ceremony": {
      "types": "./dist/claim-home-ceremony.d.ts",
      "import": "./dist/claim-home-ceremony.js"
    },
    "./ceremony-signer": {
      "types": "./dist/ceremony-signer.d.ts",
      "import": "./dist/ceremony-signer.js"
    },
    "./client": {
      "types": "./dist/client.d.ts",
      "import": "./dist/client.js"
    },
    "./device-lifecycle-ceremony": {
      "types": "./dist/device-lifecycle-ceremony.d.ts",
      "import": "./dist/device-lifecycle-ceremony.js"
    },
    "./host-pin-refresh": {
      "types": "./dist/host-pin-refresh.d.ts",
      "import": "./dist/host-pin-refresh.js"
    },
    "./recovery-card-pdf": {
      "types": "./dist/recovery-card-pdf.d.ts",
      "import": "./dist/recovery-card-pdf.js"
    },
    "./device-recovery-ceremony": {
      "types": "./dist/device-recovery-ceremony.d.ts",
      "import": "./dist/device-recovery-ceremony.js"
    },
    "./link-direct-client": {
      "types": "./dist/link-direct-client.d.ts",
      "import": "./dist/link-direct-client.js"
    }
  },
  "bin": {
    "pico-vault": "dist/cli.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "pretest": "tsc -p tsconfig.json",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "dependencies": {
    "@pico/identity": "workspace:*",
    "@pico/protocol": "workspace:*",
    "@pico/vault": "workspace:*",
    "libsodium-wrappers-sumo": "^0.8.4",
    "pdf-lib": "1.17.1",
    "qrcode": "1.5.4"
  },
  "devDependencies": {
    "@pico/core": "workspace:*",
    "@pico/sync": "workspace:*",
    "@types/qrcode": "1.5.6"
  }
}
