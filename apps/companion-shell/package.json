{
  "name": "@pico/companion-shell",
  "version": "0.1.9",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "main": "dist/main.js",
  "scripts": {
    "build": "tsc -p tsconfig.json && node scripts/copy-renderer.mjs",
    "check": "tsc -p tsconfig.json --noEmit",
    "package:linux": "node scripts/package-linux.mjs",
    "prepackage:linux": "pnpm build",
    "preverify:linux": "pnpm build",
    "start": "electron dist/main.js",
    "test:electron": "electron --headless dist/electron-smoke.js",
    "verify:linux": "node scripts/verify-linux-package.mjs",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "files": [
    "dist"
  ],
  "dependencies": {
    "@pico/companion": "workspace:*",
    "@pico/protocol": "workspace:*",
    "@pico/vault": "workspace:*",
    "@pico/vault-daemon": "workspace:*",
    "libsodium-wrappers-sumo": "^0.8.4"
  },
  "devDependencies": {
    "@pico/core": "workspace:*",
    "electron": "43.4.0"
  }
}
