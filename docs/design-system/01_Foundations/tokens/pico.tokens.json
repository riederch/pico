    "fast": { "$type": "duration", "$value": { "value": 150, "unit": "ms" } },
    "normal": { "$type": "duration", "$value": { "value": 240, "unit": "ms" } },
    "slow": { "$type": "duration", "$value": { "value": 360, "unit": "ms" } },
    "easeStandard": { "$type": "cubicBezier", "$value": [0.2, 0.8, 0.2, 1] }
  },
  "typography": {
    "$description": "Only what Typography.md states as a value. Its sizes and line heights are minima and ranges, so they stay rules for people rather than becoming invented token values.",
