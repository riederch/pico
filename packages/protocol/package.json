{
  "name": "@pico/protocol",
  "version": "0.1.9",
  "private": true,
  "license": "SEE LICENSE IN LICENSE",
  "type": "module",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js"
    },
    "./module": {
      "types": "./dist/module.d.ts",
      "import": "./dist/module.js"
    },
    "./offline-floor": {
      "types": "./dist/offline-floor.d.ts",
      "import": "./dist/offline-floor.js"
    },
    "./spatial-recall": {
      "types": "./dist/spatial-recall.d.ts",
      "import": "./dist/spatial-recall.js"
    },
    "./planner-reader": {
      "types": "./dist/planner-reader.d.ts",
      "import": "./dist/planner-reader.js"
    },
    "./time-bound-entry": {
      "types": "./dist/time-bound-entry.d.ts",
      "import": "./dist/time-bound-entry.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "check": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage"
  },
  "devDependencies": {
    "libsodium-wrappers-sumo": "^0.8.4"
  }
}
