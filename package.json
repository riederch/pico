{
  "name": "pico",
  "private": true,
  "version": "0.2.1",
  "license": "SEE LICENSE IN LICENSE",
  "description": "Local-first personal AI companion foundation.",
  "type": "module",
  "scripts": {
    "addon:check": "node scripts/check-addon-config.mjs",
    "browser:check": "node scripts/check-browser-modules.mjs",
    "build": "pnpm -r build",
    "character:measure": "node tools/character-silhouette/measure.mjs",
    "check": "pnpm -r check",
    "clock:check": "NODE_OPTIONS=\"--import $PWD/scripts/shift-clock.mjs\" pnpm -r --workspace-concurrency=1 test",
    "companion:check": "node scripts/check-companion-boundary.mjs && node scripts/check-electron-support.mjs",
    "capability:check": "node scripts/check-capability-reach.mjs",
    "android:check": "node scripts/check-android-keystore-names.mjs",
    "authority:check": "node scripts/check-authority-resources.mjs",
    "await:check": "node scripts/check-awaited-secrets.mjs",
    "voice:check": "node scripts/check-one-voice.mjs",
    "companion:measure-headless": "pnpm --filter @pico/companion-shell measure:headless",
    "companion:electron-check": "pnpm --filter @pico/companion-shell test:electron",
    "companion:release-check": "pnpm --filter @pico/companion-shell verify:linux",
    "design-system:check": "node scripts/generate-design-tokens.mjs --check && node scripts/check-design-system.mjs",
    "design-system:generate": "node scripts/generate-design-tokens.mjs --write",
    "design-system:manifest": "node scripts/update-design-system-manifest.mjs",
    "dev:core": "pnpm --filter @pico/core dev",
    "display-zone:check": "node scripts/check-display-zones.mjs",
    "docs:check": "node scripts/check-docs-structure.mjs",
    "fingerprint:check": "node scripts/check-fingerprint-display.mjs",
    "instant:check": "node scripts/check-instant-rules.mjs",
    "key-record:check": "node scripts/check-key-record-suites.mjs",
    "label:check": "node scripts/check-signature-labels.mjs",
    "license:check": "node scripts/check-license.mjs",
    "link:check": "node scripts/check-link-seal.mjs",
    "progress:walk": "node scripts/measure-progress-numbers.mjs",
    "link:walk": "node scripts/measure-link-walk.mjs",
    "route:walk": "node scripts/measure-route-walk.mjs",
    "module:check": "node scripts/check-modules.mjs",
    "offline:check": "node scripts/check-offline-floor.mjs",
    "presence:check": "node scripts/check-presence-affordances.mjs",
    "product:check": "node scripts/check-product-path.mjs",
    "push:check": "node scripts/check-push-boundary.mjs",
    "reach:check": "node scripts/check-link-reachability.mjs",
    "relay:check": "node scripts/check-relay-boundary.mjs",
    "release:tag-check": "node scripts/check-release-tag.mjs",
    "verify:gates": "pnpm license:check && pnpm version:check && pnpm addon:check && pnpm product:check && pnpm settings:check && pnpm surface:check && pnpm design-system:check && pnpm companion:check && pnpm android:check && pnpm await:check && pnpm voice:check && pnpm fingerprint:check && pnpm instant:check && pnpm link:check && pnpm relay:check && pnpm push:check && pnpm runtime:check && pnpm wire:check && pnpm authority:check && pnpm key-record:check && pnpm label:check && pnpm browser:check && pnpm time:check && pnpm offline:check && pnpm supply:check && pnpm split:check && pnpm cycle:check && pnpm copies:check && pnpm canonical:check && pnpm vacuity:check && pnpm build && pnpm module:check && pnpm presence:check && pnpm docs:check && pnpm supplier:check && pnpm store:check && pnpm ceiling:check && pnpm reach:check && pnpm capability:check && pnpm companion:electron-check && pnpm companion:release-check",
    "verify:passes": "pnpm test && pnpm clock:check && pnpm display-zone:check",
    "release:verify": "pnpm verify:gates && pnpm verify:passes",
    "runtime:check": "node scripts/check-runtime-floor.mjs",
    "settings:check": "node scripts/check-settings-boundary.mjs",
    "store:check": "node scripts/check-store-writers.mjs",
    "ceiling:check": "node scripts/check-store-ceilings.mjs",
    "supplier:check": "node scripts/check-suppliers.mjs",
    "supply:check": "node scripts/check-workflow-pinning.mjs",
    "copies:check": "node scripts/check-constant-copies.mjs",
    "split:check": "node scripts/check-verify-split.mjs",
    "surface:check": "node scripts/check-surface-classes.mjs",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "test:coverage": "pnpm -r test:coverage",
    "time:check": "node scripts/check-time-authority.mjs",
    "canonical:check": "node scripts/check-canonical-bytes.mjs",
    "cycle:check": "node scripts/check-barrel-cycles.mjs",
    "vacuity:check": "node scripts/check-vacuous-gates.mjs",
    "version:check": "node scripts/check-version.mjs",
    "wire:check": "node scripts/check-wire-labels.mjs"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "typescript": "^5.5.0",
    "tsx": "^4.19.0",
    "vitest": "^2.0.0"
  },
  "packageManager": "pnpm@9.0.0+sha512.b4106707c7225b1748b61595953ccbebff97b54ad05d002aa3635f633b9c53cd666f7ce9b8bc44704f1fa048b9a49b55371ab2d9e9d667d1efe2ef1514bcd513"
}
