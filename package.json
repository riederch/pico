{
  "name": "pico",
  "private": true,
  "version": "0.1.9",
  "license": "SEE LICENSE IN LICENSE",
  "description": "Local-first personal AI companion foundation.",
  "type": "module",
  "scripts": {
    "build": "pnpm -r build",
    "check": "pnpm -r check",
    "character:measure": "node tools/character-silhouette/measure.mjs",
    "dev:core": "pnpm --filter @pico/core dev",
    "design-system:generate": "node scripts/generate-design-tokens.mjs --write",
    "design-system:manifest": "node scripts/update-design-system-manifest.mjs",
    "design-system:check": "node scripts/generate-design-tokens.mjs --check && node scripts/check-design-system.mjs",
    "addon:check": "node scripts/check-addon-config.mjs",
    "license:check": "node scripts/check-license.mjs",
    "release:tag-check": "node scripts/check-release-tag.mjs",
    "version:check": "node scripts/check-version.mjs",
    "test": "pnpm -r --workspace-concurrency=1 test",
    "test:coverage": "pnpm -r test:coverage",
    "release:verify": "pnpm license:check && pnpm version:check && pnpm addon:check && pnpm design-system:check && pnpm companion:check && pnpm build && pnpm companion:release-check && pnpm check && pnpm test",
    "companion:check": "node scripts/check-companion-boundary.mjs && node scripts/check-electron-support.mjs",
    "companion:release-check": "pnpm --filter @pico/companion-shell verify:linux"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "@vitest/coverage-v8": "^2.0.0",
    "typescript": "^5.5.0",
    "tsx": "^4.19.0",
    "vitest": "^2.0.0"
  },
  "packageManager": "pnpm@9.0.0"
}
