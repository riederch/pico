<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.pico.a1probe">
  <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34" />
  <!-- Without this the Link client cannot open a socket at all: Android
       answers EPERM, `fetch` says only "fetch failed", and a confirmation
       loop spends two minutes deciding the Home never answered. The Home was
       answering; nothing was allowed to ask. -->
  <uses-permission android:name="android.permission.INTERNET" />
  <!-- ADR 0131 A7: ob dieses Telefon ein Netz sieht, ist eine Tatsache des
       Systems. Ohne diese Berechtigung wirft `getActiveNetwork`, und der
       Dienst stirbt vor Node - am 2026-08-24 genau so am Gerät gesehen. -->
  <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <!-- ADR 0131 A4. Declared so the *restricted* half can be measured: on
       Android 14+ this is granted by app-op, not by declaration, and a
       non-calling app meets it denied. That default is the measurement. -->
  <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
  <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />
  <!-- RECEIVE_BOOT_COMPLETED stand hier bis zum 2026-09-20 (Befund B228).
       Es gibt keinen `<receiver>` in dieser Datei und keinen
       BroadcastReceiver in den Quellen, also konnte die Berechtigung
       nichts einloesen: erbeten und unbenutzbar. Ein Produkt, dessen
       These Zurueckhaltung ist, fragt nicht nach Rechten, die es nicht
       braucht - auch nicht in einer Messsonde. `manifest:check` haelt
       das jetzt: jede erklaerte Berechtigung nennt ihren Beleg. -->
  <!-- ADR 0131 A5: a grant is eleven hundred characters and lives four
       minutes, so the camera is the path rather than a convenience. -->
  <uses-permission android:name="android.permission.CAMERA" />
  <uses-feature android:name="android.hardware.camera" android:required="false" />
  <!-- ADR 0129 SR5. Ohne diese Zeile wirft `getCurrentLocation` eine
       SecurityException, und eine fehlende Zeile im Manifest wuerde zu einer
       Sonde, die nichts sagt. -->
  <uses-permission android:name="android.permission.ACCESS_FINE_LOCATION" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_LOCATION" />
  <application android:label="Pico A1 Probe" android:debuggable="true"
      android:extractNativeLibs="true">
    <service android:name=".CustodyService" android:process=":custody"
        android:exported="true" android:foregroundServiceType="specialUse">
      <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
          android:value="pico_a1_runtime_probe" />
    </service>
    <service android:name=".ClientService"
        android:exported="true" android:foregroundServiceType="specialUse">
      <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
          android:value="pico_a1_runtime_probe" />
    </service>
    <!-- ADR 0131 A1: what this runtime actually provides, asked in its own
         process so it can be asked at any time. -->
<!-- ADR 0131 A3: der zweite Prozess, der prüft, ob das Versiegelte sich
         noch öffnet. Eigener Prozess, weil nodejs-mobile eine Node-Instanz je
         Prozess hält - und weil ein Siegel, das nur im erzeugenden Prozess
         aufgeht, kein Siegel ist. -->
    <service android:name=".ReopenService" android:process=":reopen"
        android:exported="true" android:foregroundServiceType="specialUse">
      <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
          android:value="pico_a1_runtime_probe" />
    </service>
    <service android:name=".ConformanceService" android:process=":conformance"
        android:exported="true" android:foregroundServiceType="specialUse">
      <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
          android:value="pico_a1_conformance" />
    </service>
    <!-- ADR 0131 A5: the walk itself, so that closing the view does not end
         a ceremony another device is waiting on. Same process as the
         Activity - one Node instance per process is nodejs-mobile's rule -
         but its own component, which is what keeps the process alive. -->
    <service android:name=".JoinService"
        android:exported="true" android:foregroundServiceType="specialUse">
      <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
          android:value="pico_a5_enrolment_walk" />
    </service>
    <!-- ADR 0131 A5, first vertical: this phone asking to be let in. Plain
         views, typed path only - no camera, because that would mean a
         dependency this machine has no build system for. -->
    <activity android:name=".ScanActivity" android:exported="false"
        android:label="Pico" />
    <activity android:name=".JoinActivity" android:exported="true"
        android:label="Pico">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>
    <!-- ADR 0131 A4: the reachability contract. Its own process, because
         what is being measured is what the system does to a process that
         only wants to keep checking. -->
    <service android:name=".ReachabilityProbeService" android:process=":reach"
        android:exported="true" android:foregroundServiceType="specialUse">
      <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
          android:value="pico_a4_reachability_probe" />
    </service>
    <service android:name=".ReachabilityJobService" android:process=":reach"
        android:exported="false"
        android:permission="android.permission.BIND_JOB_SERVICE" />
    <!-- ADR 0131 A7: der Lauf, der das Home wirklich fragt. Eigener Prozess,
         weil nodejs-mobile eine Node-Instanz je Prozess hält und der
         Vault-Daemon in `:custody` schon eine hat. -->
    <service android:name=".ReachabilityConditionService" android:process=":conditions"
        android:exported="true" android:foregroundServiceType="specialUse">
      <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
          android:value="pico_a7_reachability_conditions" />
    </service>
    <!-- ADR 0118 O1: was faellig ist, und die Quittung dafuer. Zwei Prozesse,
         weil nodejs-mobile eine Node-Instanz je Prozess haelt - und getrennt
         voneinander, weil das Lesen einem Takt folgt und die Quittung einem
         Menschen. -->
    <service android:name=".DueEntriesService" android:process=":entries"
        android:exported="true" android:foregroundServiceType="specialUse">
      <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
          android:value="pico_o1_due_entries" />
    </service>
    <service android:name=".DueEntryAcknowledgeService" android:process=":entryack"
        android:exported="true" android:foregroundServiceType="specialUse">
      <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
          android:value="pico_o1_due_entry_acknowledge" />
    </service>
    <!-- ADR 0129 SR5: die eine Stelle, an der ein Standort-API vorkommt.
         Eigener Prozess wie jede Sonde; der Vordergrundtyp ist `location`,
         weil Android genau dafuer einen eigenen kennt und `specialUse` hier
         eine Verschleierung waere. -->
    <service android:name=".LocationCaptureService" android:process=":capture"
        android:exported="true" android:foregroundServiceType="location" />
    <!-- ADR 0131 A3: no Node, no stage - pure platform API, so it neither
         loads libnode nor shares a process with anything that does. -->
    <service android:name=".KeystoreProbeService" android:process=":keystore"
        android:exported="true" android:foregroundServiceType="specialUse">
      <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
          android:value="pico_a3_keystore_probe" />
    </service>
  </application>
</manifest>
