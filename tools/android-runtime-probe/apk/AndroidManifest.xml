<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.pico.a1probe">
  <uses-sdk android:minSdkVersion="26" android:targetSdkVersion="34" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE" />
  <uses-permission android:name="android.permission.FOREGROUND_SERVICE_SPECIAL_USE" />
  <uses-permission android:name="android.permission.POST_NOTIFICATIONS" />
  <!-- ADR 0131 A4. Declared so the *restricted* half can be measured: on
       Android 14+ this is granted by app-op, not by declaration, and a
       non-calling app meets it denied. That default is the measurement. -->
  <uses-permission android:name="android.permission.USE_FULL_SCREEN_INTENT" />
  <uses-permission android:name="android.permission.PACKAGE_USAGE_STATS" />
  <uses-permission android:name="android.permission.RECEIVE_BOOT_COMPLETED" />
  <!-- ADR 0131 A5: a grant is eleven hundred characters and lives four
       minutes, so the camera is the path rather than a convenience. -->
  <uses-permission android:name="android.permission.CAMERA" />
  <uses-feature android:name="android.hardware.camera" android:required="false" />
  <application android:label="Pico A1 Probe" android:debuggable="true"
      android:extractNativeLibs="true">
    <service android:name=".CustodyService" android:process=":custody"
        android:exported="true" android:foregroundServiceType="specialUse">
      <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
          android:value="pico_a1_runtime_probe" />
    </service>
    <service android:name=".ClientService"
        android:exported="true" android:foregroundServiceType="specialUse">
      <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
          android:value="pico_a1_runtime_probe" />
    </service>
    <!-- ADR 0131 A5, first vertical: this phone asking to be let in. Plain
         views, typed path only - no camera, because that would mean a
         dependency this machine has no build system for. -->
    <activity android:name=".ScanActivity" android:exported="false"
        android:label="Pico" />
    <activity android:name=".JoinActivity" android:exported="true"
        android:label="Pico">
      <intent-filter>
        <action android:name="android.intent.action.MAIN" />
        <category android:name="android.intent.category.LAUNCHER" />
      </intent-filter>
    </activity>
    <!-- ADR 0131 A4: the reachability contract. Its own process, because
         what is being measured is what the system does to a process that
         only wants to keep checking. -->
    <service android:name=".ReachabilityProbeService" android:process=":reach"
        android:exported="true" android:foregroundServiceType="specialUse">
      <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
          android:value="pico_a4_reachability_probe" />
    </service>
    <service android:name=".ReachabilityJobService" android:process=":reach"
        android:exported="false"
        android:permission="android.permission.BIND_JOB_SERVICE" />
    <!-- ADR 0131 A3: no Node, no stage - pure platform API, so it neither
         loads libnode nor shares a process with anything that does. -->
    <service android:name=".KeystoreProbeService" android:process=":keystore"
        android:exported="true" android:foregroundServiceType="specialUse">
      <property android:name="android.app.PROPERTY_SPECIAL_USE_FGS_SUBTYPE"
          android:value="pico_a3_keystore_probe" />
    </service>
  </application>
</manifest>
